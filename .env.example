INSIGHTS_ENV=TEST

# Mines endpoint URLs and database IDs come from
# config/institutions/mines/insights.json. Usually only API keys belong here.
INSIGHTS_TEST_API_KEY=
INSIGHTS_PROD_API_KEY=

# For a different deployment, explicitly override both values for an
# environment. Never use a credential-bearing URL.
# INSIGHTS_TEST_BASE_URL=https://your-test-insights-host.example.edu
# INSIGHTS_TEST_DATABASE_ID=1
# INSIGHTS_TEST_SSO_START_URL=https://your-portal.example.edu
# INSIGHTS_PROD_BASE_URL=https://your-prod-insights-host.example.edu
# INSIGHTS_PROD_DATABASE_ID=1
# INSIGHTS_PROD_SSO_START_URL=https://your-portal.example.edu
