# !package-lock.json

# Private keys and certificates
*.ppk
*.pem
*.key
*.p12
*.pfx
id_rsa
id_dsa
id_ecdsa
id_ed25519

# OS and local application files
.DS_Store
.Rhistory
Thumbs.db

# VS Code
.vscode/

