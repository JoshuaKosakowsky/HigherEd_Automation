# Python virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example
secrets/
credentials/

# Python cache
__pycache__/
*.py[cod]

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Logs
# Preserve directories containing .gitkeep, but ignore their contents
logs/**
!logs/**/
!logs/**/.gitkeep
*.log

# Data files and archives
*.zip
*.xlsx
*.xls
*.xlsm
*.csv
*.tsv
*.parquet
*.lis
*.xml

# JSON data
# Detail-code data is generated locally and may contain operational metadata.
detail_codes.json

# Allow specific JSON files that belong to the application
